# Integration test for net.tls.client.
#
# net.tls.client upgrades a connected Socket into a TLS-wrapped Socket
# by running the rustls handshake eagerly. Failure (bad cert, hostname
# mismatch, protocol error, empty hostname, etc.) surfaces as
# (0, false) — matching every other fallible Seq networking word.
#
# Offline integration tests only cover failure paths: a happy-path
# round-trip would need either a real HTTPS endpoint (not allowed in
# CI) or a same-process TLS server (tracked in issue #483). The
# happy path is verified manually against https://example.com and
# via the PR4 HTTP rewrite which exercises real TLS end-to-end.
#
# Each test binds on port 0 and uses net.tcp.local-port to discover
# the OS-assigned port — no hardcoded magic numbers.

# -----------------------------------------------------------------------------
# Shared bad-server: accepts one TCP connection and closes it without
# speaking TLS. Used by every handshake-failure test below.
# -----------------------------------------------------------------------------

: bad-server-body ( Socket -- )
  net.tcp.accept
  [ ] [ "bad-server: accept failed" io.write-line 1 os.exit ] if
  net.tcp.close test.assert
;

# Echo server for the empty-host test, which needs a live stream
# after the rejected TLS call to prove the slot wasn't disturbed.
: echo-server-body ( Socket -- )
  net.tcp.accept
  [ ] [ "echo-server: accept failed" io.write-line 1 os.exit ] if
  dup net.tcp.read                             # ( client req bool )
  [ "ping" test.assert-eq-str ]
  [ drop "echo-server: read failed" io.write-line 1 os.exit ]
  if
  "pong" over net.tcp.write
  test.assert
  net.tcp.close test.assert
;

# -----------------------------------------------------------------------------
# Empty hostname fast-fails AND leaves the input socket usable.
#
# Uses a real connected stream from a same-process listen+connect.
# Empty hostname must short-circuit inside net.tls.client without
# touching the client socket's registry slot — proven here by
# completing the ping/pong round-trip *after* the rejected upgrade.
# -----------------------------------------------------------------------------

: test-net-tls-client-empty-host-leaves-socket-usable ( -- )
  0 net.tcp.listen
  [ ] [ "listen failed" io.write-line 1 os.exit ] if
  dup net.tcp.local-port
  [ ] [ "local-port failed" io.write-line 1 os.exit ] if
  # ( listener port )
  [ drop echo-server-body ] strand.spawn drop  # ( listener port )

  "127.0.0.1" swap net.tcp.connect             # ( listener client bool )
  [ ] [ "connect to echo-server failed" io.write-line 1 os.exit ] if

  # Attempt TLS upgrade with empty hostname — must fail without
  # disturbing the client socket's registry slot.
  dup ""                                       # ( listener client client "" )
  net.tls.client                               # ( listener client new bool )
  test.assert-not                              # bool must be false
  drop                                         # discard 0 sentinel
  # ( listener client )

  # Prove the original client socket is still alive and the slot still
  # holds a Tcp variant by completing the ping/pong with the server.
  "ping" over net.tcp.write
  test.assert
  dup net.tcp.read
  [ "pong" test.assert-eq-str ]
  [ drop "client: read after rejected TLS upgrade failed" io.write-line 1 os.exit ]
  if
  net.tcp.close test.assert
  net.tcp.close test.assert
;

# -----------------------------------------------------------------------------
# TLS handshake against a plain-TCP listener fails with an IP-literal SNI.
# Isolates the failure to the transport-error path (peer FINs before
# any TLS bytes arrive); IP-literal ServerName parses cleanly.
# -----------------------------------------------------------------------------

: test-net-tls-client-handshake-fails-ip-sni ( -- )
  0 net.tcp.listen
  [ ] [ "listen failed" io.write-line 1 os.exit ] if
  dup net.tcp.local-port
  [ ] [ "local-port failed" io.write-line 1 os.exit ] if
  [ drop bad-server-body ] strand.spawn drop

  "127.0.0.1" swap net.tcp.connect
  [ ] [ "connect to bad-server failed" io.write-line 1 os.exit ] if

  "127.0.0.1" net.tls.client                   # ( listener new bool )
  test.assert-not
  drop

  # The original client Socket was consumed: build_tls dropped the
  # TcpStream on Err (closing the underlying socket), and tls.client
  # then released the id back to the free list. Only the listener
  # remains.
  net.tcp.close test.assert
;

# -----------------------------------------------------------------------------
# TLS handshake against a plain-TCP listener fails with a DNS-form SNI.
# Confirms the DNS-name ServerName parse path reaches the handshake
# before the transport-error path fails it (separate code path inside
# rustls's ServerName::try_from from the IP-literal case above).
# -----------------------------------------------------------------------------

: test-net-tls-client-handshake-fails-dns-sni ( -- )
  0 net.tcp.listen
  [ ] [ "listen failed" io.write-line 1 os.exit ] if
  dup net.tcp.local-port
  [ ] [ "local-port failed" io.write-line 1 os.exit ] if
  [ drop bad-server-body ] strand.spawn drop

  "127.0.0.1" swap net.tcp.connect
  [ ] [ "connect to bad-server failed" io.write-line 1 os.exit ] if

  # .invalid is RFC 2606; ServerName parses it (it's a syntactically
  # valid DNS name), so the failure path is complete_io reporting the
  # peer FIN — same transport-error path as the IP-SNI test above,
  # reached via the DNS-name branch of ServerName::try_from.
  "no-such-host.invalid" net.tls.client
  test.assert-not
  drop

  net.tcp.close test.assert
;
