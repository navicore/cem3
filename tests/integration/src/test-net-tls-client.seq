# Integration test for net.tls.client.
#
# net.tls.client upgrades a connected Socket into a TLS-wrapped Socket
# by running the rustls handshake eagerly. Failure (bad cert, hostname
# mismatch, protocol error, empty hostname, etc.) surfaces as
# (0, false) — matching every other fallible Seq networking word.
#
# Offline integration tests only cover failure paths: a happy-path
# round-trip would need either a real HTTPS endpoint (not allowed in
# CI) or a same-process TLS server (which is PR-5+ scope — we don't
# expose TLS server primitives yet). The happy path is verified
# manually against https://example.com and via the upcoming PR4 HTTP
# rewrite which exercises real TLS end-to-end.

: tls-test-port ( -- Int )
  # Distinct from tcp-test-port / tcp-test-port-2 used by the
  # net.tcp.connect tests so parallel collisions are impossible even
  # if cleanup is slow.
  54331
;

: tls-test-port-bad ( -- Int ) 54332 ;

# -----------------------------------------------------------------------------
# Empty hostname fast-fails before any IO.
# -----------------------------------------------------------------------------

: test-net-tls-client-empty-host-fails ( -- )
  # Pre-condition: a Socket on the stack. We grab one from
  # net.tcp.listen since the type checker requires Socket, not Int.
  # Empty hostname short-circuits inside net.tls.client without
  # touching the listener's registry slot, so we can close it
  # afterwards.
  tls-test-port net.tcp.listen
  [ ] [ "listen failed (port in use?)" io.write-line 1 os.exit ] if
  # ( listener )
  dup ""                                # ( listener listener "" )
  net.tls.client                        # ( listener new bool )
  test.assert-not                       # must be false
  drop                                  # discard the 0 socket sentinel
  net.tcp.close test.assert
;

# -----------------------------------------------------------------------------
# TLS handshake against a plain-TCP listener fails.
# -----------------------------------------------------------------------------

: bad-server-body ( Socket -- )
  # Accepts one connection and immediately closes it. The rustls
  # ClientHello goes out; the peer responds with FIN; rustls reports
  # a transport error from complete_io. net.tls.client returns
  # (0, false).
  net.tcp.accept
  [ ] [ "bad-server: accept failed" io.write-line 1 os.exit ] if
  net.tcp.close test.assert
;

: test-net-tls-client-handshake-fails ( -- )
  tls-test-port-bad net.tcp.listen
  [ ] [ "bad-server: listen failed" io.write-line 1 os.exit ] if
  [ bad-server-body ] strand.spawn drop

  "127.0.0.1" tls-test-port-bad net.tcp.connect
  [ ] [ "connect to bad-server failed" io.write-line 1 os.exit ] if
  # ( listener client )

  # Use an IP literal as the SNI/hostname — rustls accepts IP-form
  # ServerName, so the failure here is the *handshake*, not name
  # validation. That isolates the test to the transport-error path.
  "127.0.0.1" net.tls.client            # ( listener new bool )
  test.assert-not                       # handshake must fail
  drop                                  # discard 0 sentinel

  # The original client Socket was consumed by the failed tls.client
  # (build_tls drops the TcpStream on Err, which closes the underlying
  # socket and frees the registry slot). Only the listener remains.
  net.tcp.close test.assert
;
