# Strands - Seq's cooperative concurrency model
# See examples/weave/counter.seq for a complete example

# Counter using weave/yield.
# `W` is a single-letter type variable standing in for the opaque WeaveCtx
# handle threaded through the loop. (The runtime has Value::WeaveCtx, but
# there is no nominal Type::WeaveCtx yet — see SOCKET_TYPE_AND_NETWORKING.md.)
: counter-loop ( W Int -- | Yield Int )
  tuck
  yield
  rot
  i.add
  counter-loop
;

: counter-body ( W Int -- | Yield Int )
  counter-loop
;

# Using a counter strand
: use-counter ( -- )
  [ counter-body ] strand.weave

  "Created counter weave" io.write-line

  10 strand.resume
  [
    "First yield: " swap int->string string.concat io.write-line
  ] [
    drop "Weave ended unexpectedly" io.write-line
  ] if

  1 strand.resume
  [
    "After +1: " swap int->string string.concat io.write-line
  ] [
    drop "Weave ended unexpectedly" io.write-line
  ] if

  5 strand.resume
  [
    "After +5: " swap int->string string.concat io.write-line
  ] [
    drop "Weave ended unexpectedly" io.write-line
  ] if

  drop
;

: main ( -- )
  "=== Strands Demo ===" io.write-line
  "" io.write-line
  use-counter
  "" io.write-line
  "Done!" io.write-line
;
