# std:imath Integration Test

include std:imath

: test-abs ( -- )
  5 abs 5 test.assert-eq
  -5 abs 5 test.assert-eq
  0 abs 0 test.assert-eq
;

: test-max ( -- )
  3 7 max 7 test.assert-eq
  7 3 max 7 test.assert-eq
  -10 -5 max -5 test.assert-eq
;

: test-min ( -- )
  3 7 min 3 test.assert-eq
  7 3 min 3 test.assert-eq
  -10 -5 min -10 test.assert-eq
;

: test-gcd ( -- )
  48 18 gcd 6 test.assert-eq
  100 35 gcd 5 test.assert-eq
  17 13 gcd 1 test.assert-eq
;

: test-pow ( -- )
  2 0 pow 1 test.assert-eq
  2 3 pow 8 test.assert-eq
  2 10 pow 1024 test.assert-eq
;

: test-sign ( -- )
  5 sign 1 test.assert-eq
  -5 sign -1 test.assert-eq
  0 sign 0 test.assert-eq
;

: test-square ( -- )
  5 square 25 test.assert-eq
  -3 square 9 test.assert-eq
  0 square 0 test.assert-eq
;

: test-clamp ( -- )
  50 0 100 clamp 50 test.assert-eq
  -10 0 100 clamp 0 test.assert-eq
  150 0 100 clamp 100 test.assert-eq
;

: test-int-to-bits ( -- )
  0 int->bits "0" test.assert-eq-str
  1 int->bits "1" test.assert-eq-str
  10 int->bits "1010" test.assert-eq-str
  12 int->bits "1100" test.assert-eq-str
  255 int->bits "11111111" test.assert-eq-str
  256 int->bits "100000000" test.assert-eq-str
;

: test-int-to-bits-padded ( -- )
  0 8 int->bits-padded "00000000" test.assert-eq-str
  10 8 int->bits-padded "00001010" test.assert-eq-str
  12 8 int->bits-padded "00001100" test.assert-eq-str
  10 4 int->bits-padded "1010" test.assert-eq-str
  255 4 int->bits-padded "1111" test.assert-eq-str
  1 1 int->bits-padded "1" test.assert-eq-str
  5 0 int->bits-padded "" test.assert-eq-str
;

: test-int-to-bits-fmt-8 ( -- )
  0 int->bits-fmt-8 "0000 0000" test.assert-eq-str
  40 int->bits-fmt-8 "0010 1000" test.assert-eq-str
  255 int->bits-fmt-8 "1111 1111" test.assert-eq-str
  170 int->bits-fmt-8 "1010 1010" test.assert-eq-str
  1 int->bits-fmt-8 "0000 0001" test.assert-eq-str
;

: test-int-to-bits-fmt-16 ( -- )
  0 int->bits-fmt-16 "0000 0000 0000 0000" test.assert-eq-str
  40 int->bits-fmt-16 "0000 0000 0010 1000" test.assert-eq-str
  43690 int->bits-fmt-16 "1010 1010 1010 1010" test.assert-eq-str
  1 int->bits-fmt-16 "0000 0000 0000 0001" test.assert-eq-str
  # 0x8001 = 32769: high bit + low bit
  32769 int->bits-fmt-16 "1000 0000 0000 0001" test.assert-eq-str
;

: test-int-to-bits-of-negative-terminates ( -- )
  # Regression: int->bits of a negative used to loop forever because
  # logical shr could never reduce it to zero. With the 63-bit clamp
  # on shr, the loop terminates. Output is lossy for negatives — the
  # contract guarded here is *termination*, not the precise string.
  -1 int->bits drop
  -42 int->bits drop
;
