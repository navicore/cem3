# Test bitwise operations

: test-band ( -- )
  0xFF 0x0F band 0x0F test.assert-eq
;

: test-bor ( -- )
  0xF0 0x0F bor 0xFF test.assert-eq
;

: test-bxor ( -- )
  0xFF 0x0F bxor 0xF0 test.assert-eq
;

: test-bnot ( -- )
  # bnot of 0 should have all bits set (i.e., -1 in two's complement)
  0 bnot -1 test.assert-eq
;

: test-shl ( -- )
  1 4 shl 16 test.assert-eq
;

: test-shr ( -- )
  16 4 shr 1 test.assert-eq
;

: test-popcount ( -- )
  0xFF popcount 8 test.assert-eq
;

: test-clz ( -- )
  # Seq Int is 63-bit; 1 has 62 leading zeros in a 63-bit int
  1 clz 62 test.assert-eq
;

: test-ctz ( -- )
  # 16 = 0b10000, has 4 trailing zeros
  16 ctz 4 test.assert-eq
;

: test-int-bits ( -- )
  # Int is 63-bit signed (the low bit of the tagged stack slot is the tag).
  int-bits 63 test.assert-eq
;

: test-hex-literals ( -- )
  0xFF 255 test.assert-eq
;

: test-binary-literals ( -- )
  0b1010 10 test.assert-eq
;

: test-shift-edge-cases ( -- )
  # Shift by 0
  42 0 shl 42 test.assert-eq
  # Shift by 30 (safe range for both 63-bit and 64-bit integers)
  1 30 shl 1073741824 test.assert-eq
  # Shift by 64 (out of range, returns 0)
  1 64 shl 0 test.assert-eq
  # Shift by negative (out of range, returns 0)
  1 -1 shl 0 test.assert-eq
  # Logical right shift: 1073741824 >> 1 = 536870912
  1073741824 1 shr 536870912 test.assert-eq
;

: test-clz-ctz-edge-cases ( -- )
  # clz(0) should be 63 (all 63 Int bits are zero)
  0 clz 63 test.assert-eq
  # ctz(0) should be 63
  0 ctz 63 test.assert-eq
;

: test-popcount-edge-cases ( -- )
  # popcount(-1) = 63 — all 63 bits of the Int are set; the i64 sign-
  # extension bit is not counted.
  -1 popcount 63 test.assert-eq
  # popcount(0) = 0
  0 popcount 0 test.assert-eq
;

: test-shl-overflow ( -- )
  # 1 61 shl = 2^61 fits in 63-bit Int.
  1 61 shl 2305843009213693952 test.assert-eq
  # 1 62 shl would be 2^62, one past the 63-bit max — clamps to 0.
  1 62 shl 0 test.assert-eq
  # 1 63 shl would be i64::MIN, far outside the 63-bit range.
  1 63 shl 0 test.assert-eq
  # -1 62 shl = -2^62 = the 63-bit min — exactly fits, kept as-is.
  -1 62 shl -4611686018427387904 test.assert-eq
  # -1 63 shl would be i64::MIN, out of 63-bit range.
  -1 63 shl 0 test.assert-eq
;

: test-shr-negative ( -- )
  # The historical bug case: -1 1 shr produced i64::MAX which then
  # silently lost bit 62 in the tagger. New contract: 0.
  -1 1 shr 0 test.assert-eq
  # -1 2 shr = u64::MAX >> 2 = 2^62 - 1 = the 63-bit max — fits.
  -1 2 shr 4611686018427387903 test.assert-eq
  # -1 62 shr = u64::MAX >> 62 = 3 — fits.
  -1 62 shr 3 test.assert-eq
;

